<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/btn_start"
            android:text="@string/start"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/status_off"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_settings" />

        <TextView android:id="@+id/label_sensitivity" style="@style/SliderLabel" />
        <SeekBar
            android:id="@+id/seek_sensitivity"
            style="@style/Slider"
            android:max="10"
            android:min="1" />

        <TextView android:id="@+id/label_size" style="@style/SliderLabel" />
        <SeekBar
            android:id="@+id/seek_size"
            style="@style/Slider"
            android:max="14"
            android:min="3" />

        <TextView android:id="@+id/label_rows" style="@style/SliderLabel" />
        <SeekBar
            android:id="@+id/seek_rows"
            style="@style/Slider"
            android:max="10"
            android:min="3" />

        <TextView android:id="@+id/label_opacity" style="@style/SliderLabel" />
        <SeekBar
            android:id="@+id/seek_opacity"
            style="@style/Slider"
            android:max="100"
            android:min="20" />

        <Button
            android:id="@+id/reset"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/reset"
            android:textAllCaps="false"
            android:textColor="@color/accent" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_howto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/howto"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
